  "engines": {
    "node": "24.14.0",
    "npm": "11.9.0"
  },
  "scripts": {
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --coverage",
    "test:watch": "vitest",
    "test:infra": "vitest run --project infra",
    "test:api": "cucumber-js --config test/acceptance-tests/cucumber.ts --profile api",
