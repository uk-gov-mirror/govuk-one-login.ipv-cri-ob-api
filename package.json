    "@smithy/signature-v4": "5.7.5",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "4.1.12",
    "eslint-plugin-perfectionist": "5.13.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  },
