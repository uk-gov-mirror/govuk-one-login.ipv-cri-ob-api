{
  "name": "ipv-cri-ob-api",
  "version": "1.0.0",
  "description": "Open Banking Credential Issuer API",
  "homepage": "https://github.com/govuk-one-login/ipv-cri-ob-api#readme",
  "bugs": {
    "url": "https://github.com/govuk-one-login/ipv-cri-ob-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/govuk-one-login/ipv-cri-ob-api.git"
  },
  "license": "MIT",
  "author": "ipv-cri-lime",
  "type": "module",
  "scripts": {
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:pre-commit": "eslint",
    "test": "vitest run --project unit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:api": "cucumber-js --profile api",
    "test:smoke": "cucumber-js --profile smoke",
    "test:infra": "vitest run --config vitest.infra.config.ts",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@aws-crypto/sha256-js": "5.2.0",
    "@aws-sdk/credential-providers": "3.1070.0",
    "@cucumber/cucumber": "12.9.0",
    "@smithy/signature-v4": "4.2.4",
    "@cucumber/html-formatter": "23.1.0",
    "@eslint/js": "10.0.1",
    "@types/aws-lambda": "8.10.162",
    "@types/node": "25.9.3",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "10.0.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-perfectionist": "5.9.1",
    "jiti": "2.7.0",
    "prettier": "3.8.4",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.1",
    "vitest": "4.1.9",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "2.31.0",
    "@aws-lambda-powertools/metrics": "2.31.0",
    "@aws-lambda-powertools/parameters": "2.31.0",
    "@aws-sdk/client-dynamodb": "3.1070.0",
    "@aws-sdk/client-kms": "3.1070.0",
    "@aws-sdk/lib-dynamodb": "3.1070.0",
    "@govuk-one-login/cri-audit": "1.0.3",
    "@govuk-one-login/cri-error-response": "1.0.0",
    "@govuk-one-login/cri-logger": "1.1.0",
    "@govuk-one-login/cri-metrics": "1.0.3",
    "@govuk-one-login/data-vocab": "2.0.2",
    "@middy/core": "7.6.7",
    "@middy/http-header-normalizer": "7.6.7",
    "ecdsa-sig-formatter": "1.0.11",
    "esbuild": "0.28.1",
    "zod": "4.4.3"
